<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base Dark Green Border & Main Body Gradient -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:startColor="#069E24"
                android:centerColor="#008016"
                android:endColor="#004D0D" />
            <stroke
                android:width="1dp"
                android:color="#005E10" />
        </shape>
    </item>

    <!-- Subtle Inner Rim / Bevel Outline -->
    <item
        android:top="6dp"
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke
                android:width="0dp"
                android:color="#4088FF9E" />
        </shape>
    </item>

    <!-- Top Glossy Highlight -->
    <item
        android:top="3dp"
        android:bottom="32dp"
        android:left="14dp"
        android:right="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:startColor="#8569FF85"
                android:endColor="#0069FF85" />
        </shape>
    </item>

</layer-list>





























