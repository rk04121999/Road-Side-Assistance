<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base Dark Red Border & Main Body Gradient -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="0"
                android:type="linear"
                android:startColor="#771A1A"
                android:centerColor="#CB0A0A"
                android:endColor="#710303" />
            <stroke
                android:width="1dp"
                android:color="#5E0000" />
        </shape>
    </item>

    <!-- Subtle Inner Rim / Bevel Outline -->
    <item
        android:top="6dp"
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <stroke
                android:width="0dp"
                android:color="#40FF8888" />
        </shape>
    </item>

    <!-- Top Glossy Highlight -->
    <item
        android:top="3dp"
        android:bottom="32dp"
        android:left="14dp"
        android:right="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="270"
                android:startColor="#85FF6969"
                android:endColor="#00FF6969" />
        </shape>
    </item>

</layer-list>




















