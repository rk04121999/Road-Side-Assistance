<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:background="@drawable/bg_service_red_gradient"
            android:gravity="center"
            android:text="Service Request Form"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Selected Service"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />



        <TextView
            android:id="@+id/tvSelectedService"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:text="Tow Truck"
            android:textColor="#B00000"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Vehicle Type"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <AutoCompleteTextView
            android:id="@+id/etVehicleType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:completionThreshold="1"
            android:hint="Type or select vehicle"
            android:inputType="textCapWords"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Select or Type Issue"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <AutoCompleteTextView
            android:id="@+id/etServiceIssue"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:completionThreshold="1"
            android:hint="Type or select your issue"
            android:inputType="textCapSentences"
            android:padding="12dp"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Current Location"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etServiceLocation"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:gravity="top|start"
            android:hint="Enter your current location or address"
            android:inputType="textPostalAddress|textMultiLine"
            android:padding="14dp"
            android:textColor="#222222"
            android:textColorHint="#777777" />

        <Button
            android:id="@+id/btnSubmitServiceRequest"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_login_btn"
            app:backgroundTint="@null"
            android:text="Submit Request"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>






























