<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTechnicianJob"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvJobService"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Service Request"
                android:textColor="#172317"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvJobStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Assigned"
                android:textColor="#E6A000"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="#EEEEEE" />

        <TextView
            android:id="@+id/tvJobVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vehicle: Car"
            android:textColor="#555555"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvJobIssue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Issue: Engine problem"
            android:textColor="#555555"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvJobLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Location: Ahmedabad"
            android:textColor="#555555"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvJobCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Customer: Customer Name"
            android:textColor="#555555"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvJobPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Phone: 9876543210"
            android:textColor="#555555"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnJobAction"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="13dp"
            android:background="@drawable/bg_login_btn"
            android:text="Review Job"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@null" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
